<script>
    function generateCaptcha() {
        const num1 = Math.floor(Math.random() * 4) + 1;
        const num2 = Math.floor(Math.random() * 6) + 1;
        document.getElementById('captcha').textContent = `${num1} + ${num2} = ?`;
        window.correctAnswer = num1 + num2;
    }

    function validateCaptcha() {
        const userInput = document.getElementById('captchaInput').value;
        const errorMessage = document.getElementById('errorMessage');
        
        if (parseInt(userInput) === window.correctAnswer) {
            errorMessage.textContent = '';
            return true; // Allow form submission
        } else {
            errorMessage.textContent = 'Incorrect CAPTCHA answer. Please try again.';
            errorMessage.style.color = 'red';
            return false; // Block form submission
        }
    }

    // Generate initial CAPTCHA on page load
    generateCaptcha();
